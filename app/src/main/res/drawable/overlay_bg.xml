<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮翻译面板背景（v1.9.0 重做）

  改动：
  - 圆角 14dp → 16dp（M3 corner-large），与整体卡片体系协调
  - 描边由 1dp 白 25% → 1dp 白 18%：M3 的浮层用「色调 + 轻描边」表达层级，
    原先的描边偏亮，深色内容上显得脏
  - 保留 #E0181818 基准色：面板是覆盖在任意界面之上的深色浮层，
    此处刻意不跟随主题（跟随主题会在浅色 App 上失去对比度）
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E0181818" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#2EFFFFFF" />
</shape>
