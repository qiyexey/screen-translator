<?xml version="1.0" encoding="utf-8"?>
<!--
  Material Symbols: arrow_back（24dp viewport）

  v1.19.0 新增。用途是 12 个页面的 TopAppBar 返回键 ——
  之前这些页面用的是**文字按钮**（描边的 MaterialButton，写着"返回"），
  activity_live_translate 更差，用的是 @android:drawable/ic_menu_revert
  （系统自带的弯箭头，M2 时代的字形，和 M3 完全不搭）。

  fillColor 用语义角色而不是写死值：
  现有图标（ic_camera / ic_settings 等）写死了 #1A73E8，夜间模式下
  深蓝压深底对比度不足。新图标直接用 @color/md_on_surface，
  它在 values/ 是 #1A1C1E、在 values-night/ 是 #E2E2E9，自动跟随深浅模式。

  MaterialToolbar 的 app:navigationIconTint 会再覆盖一次，
  所以这里即使被别处复用到彩色背景上也不会串色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/md_on_surface"
        android:pathData="M20,11H7.83l5.59,-5.59L12,4l-8,8 8,8 1.41,-1.41L7.83,13H20v-2z" />
</vector>
