<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 主题（v1.9.0）

  从 Theme.MaterialComponents（M2）升级到 Theme.Material3（M3）。
  这是本次界面重做的结构性改动 —— M2 主题下：
  - 组件默认样式偏旧（按钮、开关、输入框都是 M2 观感）
  - 没有 M3 的语义色角色，夜间模式无法正确工作
  - 卡片、控件的圆角与高度规范都是 M2 的

  色值全部来自 colors.xml 的 M3 语义角色，主题本身不写死任何颜色。
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.ScreenTranslator" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主色角色 -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>

        <!-- 次要/第三色 -->
        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>
        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <!-- 错误色 -->
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <!-- 表面与文字（M3 用色调表达层级，因此 surface 家族要齐全） -->
        <item name="android:colorBackground">@color/md_surface</item>
        <item name="colorOnBackground">@color/md_on_surface</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/md_on_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_surface</item>
        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>

        <!-- 描边 -->
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>

        <!-- 状态栏跟随主题表面色，避免状态栏与内容割裂 -->
        <item name="android:statusBarColor">@color/md_surface</item>
        <item name="android:navigationBarColor">@color/md_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- 划词菜单入口用的透明主题 -->
    <style name="Theme.ScreenTranslator.Transparent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsFloating">false</item>
    </style>

    <!-- ==================== M3 组件样式统一覆写 ==================== -->
    <!-- 卡片：M3 规范圆角 12dp，层级用色调而非重阴影 -->
    <style name="Widget.ScreenTranslator.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/md_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/md_surface_container_low</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- 主按钮：M3 Filled（胶囊形） -->
    <style name="Widget.ScreenTranslator.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">22dp</item>
    </style>

    <!-- 次按钮：M3 Outlined -->
    <style name="Widget.ScreenTranslator.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">22dp</item>
        <item name="strokeColor">@color/md_outline</item>
    </style>

    <!-- 文字按钮 -->
    <style name="Widget.ScreenTranslator.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- 章节标题：M3 TitleMedium -->
    <style name="TextAppearance.ScreenTranslator.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <!-- 正文：M3 BodyMedium -->
    <style name="TextAppearance.ScreenTranslator.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

    <!-- 辅助说明：M3 BodySmall，用 on-surface-variant -->
    <style name="TextAppearance.ScreenTranslator.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>

    <!-- 标签：M3 LabelLarge -->
    <style name="TextAppearance.ScreenTranslator.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/md_on_surface</item>
    </style>

</resources>
