<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 语义色系统（v1.9.0 界面重做）

  为什么改成角色制：
  旧版只有 6 个裸色值（bg_primary / accent / …），导致三个问题 ——
    ① 夜间模式只换了主色，背景仍是浅色，等于坏的；
    ② 语义丢失：同一个 #4CAF50 既当按钮色又当状态色，改一处影响全身；
    ③ 对比度不足：#4CAF50 配白字对比度只有 2.78（WCAG 需 ≥4.5），所以旧界面发飘。

  现在按 M3 规范定义「角色」，组件只引用角色、不引用具体色值：
  primary / on-primary / primary-container / on-primary-container / surface 家族 / outline …

  绿色系的 M3 化处理（保留品牌连续性的关键）：
  #4CAF50 太亮，无法承载白字，因此按 M3 的做法把它「下沉」为 primary-container，
  另配一个更深的 primary（#006D3B，白字对比度 6.46 ✓）承载主操作。
  这样既保住绿色观感，又满足无障碍标准。
-->
<resources>

    <!-- ==================== 主色（绿色系）==================== -->
    <!-- 白天：深绿承载白字（对比 6.46:1） -->
    <color name="md_primary">#006D3B</color>
    <color name="md_on_primary">#FFFFFF</color>
    <!-- 原 #4CAF50 下沉为容器色（浅绿底配深绿字，对比 9.90:1） -->
    <color name="md_primary_container">#A8F0C0</color>
    <color name="md_on_primary_container">#00391F</color>

    <!-- ==================== 次要色（低饱和灰绿，做中性强调）==================== -->
    <color name="md_secondary">#4F6354</color>
    <color name="md_on_secondary">#FFFFFF</color>
    <color name="md_secondary_container">#D2E8D5</color>
    <color name="md_on_secondary_container">#0C1F14</color>

    <!-- ==================== 第三色（青绿，做点缀，如收藏星标）==================== -->
    <color name="md_tertiary">#3A6470</color>
    <color name="md_on_tertiary">#FFFFFF</color>
    <color name="md_tertiary_container">#BEEAF7</color>
    <color name="md_on_tertiary_container">#001F27</color>

    <!-- ==================== 错误色 ==================== -->
    <color name="md_error">#B3261E</color>
    <color name="md_on_error">#FFFFFF</color>
    <color name="md_error_container">#F9DEDC</color>
    <color name="md_on_error_container">#410E0B</color>

    <!-- ==================== 表面层次（M3 用色调表达层级，而非阴影）==================== -->
    <color name="md_surface">#FCFDF7</color>
    <color name="md_on_surface">#1A1C1A</color>
    <color name="md_surface_variant">#DEE5DC</color>
    <color name="md_on_surface_variant">#424940</color>
    <color name="md_surface_container_lowest">#FFFFFF</color>
    <color name="md_surface_container_low">#F6FBF3</color>
    <color name="md_surface_container">#F0F5EE</color>
    <color name="md_surface_container_high">#EAEFE8</color>
    <color name="md_surface_container_highest">#E4EAE2</color>

    <!-- ==================== 描边 ==================== -->
    <color name="md_outline">#72796F</color>
    <color name="md_outline_variant">#C2C9BE</color>

    <!-- ==================== 状态（成功/警告/信息）==================== -->
    <color name="md_success">#006D3B</color>
    <color name="md_warning">#7A5900</color>
    <color name="md_warning_container">#FFDF9E</color>
    <color name="md_on_warning_container">#261A00</color>

    <!-- ==================== 兼容旧引用（逐步淘汰，避免一次性改爆）==================== -->
    <!-- 这些名字在旧布局里被引用；映射到 M3 角色，保证改主题即全局生效 -->
    <color name="bg_primary">@color/md_surface</color>
    <color name="bg_card">@color/md_surface_container_low</color>
    <color name="text_primary">@color/md_on_surface</color>
    <color name="text_secondary">@color/md_on_surface_variant</color>
    <color name="accent">@color/md_primary</color>
    <color name="divider">@color/md_outline_variant</color>

</resources>
