<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 深色语义色 —— 蓝色主题（v1.19.0）

  与 values/colors.xml 一一对应，只是把色阶整体翻转：
  - primary 在深色下变「浅」（#A8C7FA），因为要在深底上可读并承载深字
  - surface 系列整体下沉（#111318 → #33353A），仍用色调表达层级

  ============================ 本次修正 ============================

  之前这里是绿色深色板，而 values/ 的 accent 是蓝色 ——
  导致**白天蓝、夜间绿**，同一个 App 两种模式两个品牌色。
  现在整套统一到蓝色。

  ============================ 别名改为真别名 ============================

  文件末尾的 6 个兼容别名不再写死色值，改为指向 M3 角色。
  好处是**结构上不可能再出现日夜不一致** —— 这正是 v1.18.0 修过的那类 bug
  （夜间模式文字看不见，根因就是这里照抄了白天的值）。
-->
<resources>

    <!-- ==================== 主色（深色下变浅，配深字）==================== -->
    <color name="md_primary">#A8C7FA</color>
    <color name="md_on_primary">#003062</color>
    <color name="md_primary_container">#0842A0</color>
    <color name="md_on_primary_container">#D3E3FD</color>
    <color name="md_inverse_primary">#1A73E8</color>

    <!-- ==================== 次要色 ==================== -->
    <color name="md_secondary">#BCC7DC</color>
    <color name="md_on_secondary">#263141</color>
    <color name="md_secondary_container">#3C4758</color>
    <color name="md_on_secondary_container">#D8E2F6</color>

    <!-- ==================== 第三色 ==================== -->
    <color name="md_tertiary">#D6BEE4</color>
    <color name="md_on_tertiary">#3D2B50</color>
    <color name="md_tertiary_container">#554168</color>
    <color name="md_on_tertiary_container">#EDDCFC</color>

    <!-- ==================== 错误色 ==================== -->
    <color name="md_error">#F2B8B5</color>
    <color name="md_on_error">#601410</color>
    <color name="md_error_container">#8C1D18</color>
    <color name="md_on_error_container">#F9DEDC</color>

    <!-- ==================== 表面层次 ==================== -->
    <color name="md_surface">#111318</color>
    <color name="md_on_surface">#E2E2E9</color>
    <color name="md_surface_variant">#44474F</color>
    <color name="md_on_surface_variant">#C4C6D0</color>
    <color name="md_surface_container_lowest">#0C0E13</color>
    <color name="md_surface_container_low">#191C20</color>
    <color name="md_surface_container">#1D2024</color>
    <color name="md_surface_container_high">#282A2F</color>
    <color name="md_surface_container_highest">#33353A</color>
    <color name="md_inverse_surface">#E2E2E9</color>
    <color name="md_inverse_on_surface">#2F3033</color>

    <!-- ==================== 描边 ==================== -->
    <color name="md_outline">#8E9099</color>
    <color name="md_outline_variant">#44474F</color>

    <!-- ==================== 状态 ==================== -->
    <!--
      v1.18.0：md_success 原来和白天同值 #1E8E3E。
      它只当文字色用，压在夜间底色 #111318 上对比度仅约 3.3:1（低于 AA 4.5:1），
      "引擎已就绪"这类关键状态夜间看不清。提到 #6DD58C 后约 10:1。
      md_warning 夜间本来就是浅色，无需调整。
    -->
    <color name="md_success">#6DD58C</color>
    <color name="md_warning">#FFDF9E</color>
    <color name="md_warning_container">#5C4200</color>
    <color name="md_on_warning_container">#FFDF9E</color>

    <!--
      ==================== 兼容旧引用 ====================
      指向 M3 角色而非写死色值 —— 详见 values/colors.xml 末尾的说明。
      这样日夜两套别名自动一致，不会再出现"夜间文字看不见"。
    -->
    <color name="bg_primary">@color/md_surface</color>
    <color name="bg_card">@color/md_surface_container_low</color>
    <color name="text_primary">@color/md_on_surface</color>
    <color name="text_secondary">@color/md_on_surface_variant</color>
    <color name="accent">@color/md_primary</color>
    <color name="divider">@color/md_outline_variant</color>

</resources>
