<?xml version="1.0" encoding="utf-8"?>
<!--
  Material 3 深色语义色（v1.9.0）

  旧版夜间模式是「坏的」：values-night/themes.xml 只换了 colorPrimary，
  背景色仍来自 values/colors.xml 的浅色值（#FAFAFA）—— 于是夜间模式下
  深色主色配浅色背景，观感割裂。

  现在按 M3 规范给出完整深色角色集：
  - primary 在深色下变「浅」（#8FE0B0），因为要在深底上可读并承载深字
  - surface 系列整体下沉（#111411 → #2B302C），仍用色调表达层级
-->
<resources>

    <!-- ==================== 主色（深色下变浅，配深字）==================== -->
    <color name="md_primary">#8FE0B0</color>
    <color name="md_on_primary">#00391F</color>
    <color name="md_primary_container">#00522B</color>
    <color name="md_on_primary_container">#A8F0C0</color>

    <!-- ==================== 次要色 ==================== -->
    <color name="md_secondary">#B6CCB9</color>
    <color name="md_on_secondary">#223528</color>
    <color name="md_secondary_container">#384B3E</color>
    <color name="md_on_secondary_container">#D2E8D5</color>

    <!-- ==================== 第三色 ==================== -->
    <color name="md_tertiary">#A2CDDB</color>
    <color name="md_on_tertiary">#023640</color>
    <color name="md_tertiary_container">#214C58</color>
    <color name="md_on_tertiary_container">#BEEAF7</color>

    <!-- ==================== 错误色 ==================== -->
    <color name="md_error">#F2B8B5</color>
    <color name="md_on_error">#601410</color>
    <color name="md_error_container">#8C1D18</color>
    <color name="md_on_error_container">#F9DEDC</color>

    <!-- ==================== 表面层次 ==================== -->
    <color name="md_surface">#111411</color>
    <color name="md_on_surface">#E1E4DD</color>
    <color name="md_surface_variant">#424940</color>
    <color name="md_on_surface_variant">#C2C9BE</color>
    <color name="md_surface_container_lowest">#0C0F0C</color>
    <color name="md_surface_container_low">#1A1D1A</color>
    <color name="md_surface_container">#1E211E</color>
    <color name="md_surface_container_high">#282B28</color>
    <color name="md_surface_container_highest">#333633</color>

    <!-- ==================== 描边 ==================== -->
    <color name="md_outline">#8C938A</color>
    <color name="md_outline_variant">#424940</color>

    <!-- ==================== 状态 ==================== -->
    <color name="md_success">#8FE0B0</color>
    <color name="md_warning">#FFDF9E</color>
    <color name="md_warning_container">#5C4200</color>
    <color name="md_on_warning_container">#FFDF9E</color>

    <!-- 兼容旧引用 -->
    <color name="bg_primary">@color/md_surface</color>
    <color name="bg_card">@color/md_surface_container_low</color>
    <color name="text_primary">@color/md_on_surface</color>
    <color name="text_secondary">@color/md_on_surface_variant</color>
    <color name="accent">@color/md_primary</color>
    <color name="divider">@color/md_outline_variant</color>

</resources>
