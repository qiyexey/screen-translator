<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 返回栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/Widget.ScreenTranslator.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="‹ 返回"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="关于与用法"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
        <!-- 说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="四种用法：\n\n⚽ 悬浮球：把绿球拖到想翻译的文字上松手，即翻译该处；单击球收起/展开结果面板\n\n🔲 框选翻译：双击悬浮球进入框选模式，在屏幕上拖出矩形框，松手即翻译框内全部文字（单击空白处取消）\n\n🌐 划词翻译：任意应用里长按选中文字，0.5 秒后自动翻译（部分应用需从菜单选「🌐 翻译」）\n\n📋 复制即翻译：开启后，长按复制文字立即翻译\n\n其余步骤：\n1. 开启「无障碍服务」和「悬浮窗权限」\n2. 填写任一翻译引擎的密钥后保存\n3. 打开任意含外文的应用即可"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowOnboarding"
            style="@style/Widget.ScreenTranslator.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="重新查看使用引导"
            android:textColor="@color/accent"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
