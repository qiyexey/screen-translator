<?xml version="1.0" encoding="utf-8"?>
<!--
  首页（v1.21.0 视觉与信息架构重构）

  设计原则：
  1. 高频操作就在首页：语言、翻译引擎、文字/图片/拍照/语音入口不再藏进设置。
  2. 只保留一个视觉主角：输入翻译卡；实时屏幕翻译作为品牌功能使用强调色卡片。
  3. 所有可点击控件至少 48dp，图标与文字并用，不再靠裸 emoji 或很小的点击热区。
  4. 权限是“运行状态”，不是普通设置，因此放在首页底部按需修复。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- 顶栏：标题是唯一主视觉；两个图标按钮保持 48dp 点击区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/main_t01"
                android:textColor="?attr/colorOnSurface"
                android:textSize="26sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistory"
                style="@style/Widget.ScreenTranslator.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/main_btn_history_content_description"
                android:text=""
                app:icon="@drawable/ic_history"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="23dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                style="@style/Widget.ScreenTranslator.Button.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/common_btn_settings_content_description"
                android:text=""
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="23dp" />
        </LinearLayout>

        <!-- 当前引擎：最常改的全局选项前移到首页，不再要求先进入设置索引页 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEngineQuick"
            style="@style/Widget.ScreenTranslator.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:gravity="center_vertical|start"
            android:maxLines="2"
            android:minHeight="48dp"
            android:text="@string/main_engine_label"
            android:textAllCaps="false"
            android:textColor="?attr/colorOnSurface"
            app:icon="@drawable/ic_translate"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="20dp"
            app:strokeColor="?attr/colorOutlineVariant" />

        <!-- 语言对：高频操作，以一个完整的圆角容器表达“这是同一组” -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ScreenTranslator.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp">

                <!-- MaterialAutoCompleteTextView 必须有 TextInputLayout 祖先；见 themes.xml -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ScreenTranslator.DropdownLayout.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/tvSrcLang"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:inputType="none"
                        android:minHeight="52dp"
                        android:paddingHorizontal="4dp"
                        android:text="@string/main_tv_src_lang"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwapLang"
                    style="@style/Widget.ScreenTranslator.Button.Icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/main_swap_language_content_description"
                    android:text=""
                    app:icon="@drawable/ic_swap_horiz"
                    app:iconSize="24dp" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.ScreenTranslator.DropdownLayout.Borderless"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/tvTargetLang"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="end|center_vertical"
                        android:inputType="none"
                        android:minHeight="52dp"
                        android:paddingHorizontal="4dp"
                        android:text="@string/main_tv_target_lang"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.ScreenTranslator.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="4dp"
            android:text="@string/main_section_quick"
            android:textAllCaps="false" />

        <!-- 输入翻译：首屏主操作。次级入口用带文字的 48dp 按钮，不再只放小图标。 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ScreenTranslator.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInputTranslate"
                    style="@style/Widget.ScreenTranslator.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:gravity="top|start"
                    android:paddingStart="12dp"
                    android:paddingTop="14dp"
                    android:text="@string/main_btn_input_translate"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="22dp" />

                <com.google.android.material.divider.MaterialDivider
                    style="@style/Widget.ScreenTranslator.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImageTranslate"
                        style="@style/Widget.ScreenTranslator.Button.Text"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/main_btn_image_translate_content_description"
                        android:text="@string/main_quick_image"
                        android:textColor="?attr/colorPrimary"
                        app:icon="@drawable/ic_image"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCameraTranslate"
                        style="@style/Widget.ScreenTranslator.Button.Text"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/main_btn_camera_translate_content_description"
                        android:text="@string/main_quick_camera"
                        android:textColor="?attr/colorPrimary"
                        app:icon="@drawable/ic_camera"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="20dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnVoiceTranslate"
                        style="@style/Widget.ScreenTranslator.Button.Text"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/main_btn_voice_translate_content_description"
                        android:text="@string/main_quick_voice"
                        android:textColor="?attr/colorPrimary"
                        app:icon="@drawable/ic_mic"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="20dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 产品核心能力：用 PrimaryContainer 建立明确的视觉重心 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="@dimen/md_corner_lg"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    style="@style/TextAppearance.ScreenTranslator.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/main_live_badge"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textStyle="bold" />

                <TextView
                    style="@style/TextAppearance.ScreenTranslator.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/main_live_title"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    style="@style/TextAppearance.ScreenTranslator.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/main_live_desc"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLiveTranslate"
                    style="@style/Widget.ScreenTranslator.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/main_live_action"
                    app:icon="@drawable/ic_image"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconSize="20dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 权限以“运行状态”呈现；用户只有异常时才需要进入完整权限页。 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ScreenTranslator.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shield" />

                    <TextView
                        style="@style/TextAppearance.ScreenTranslator.Subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/main_permission_title"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPermission"
                        style="@style/Widget.ScreenTranslator.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/main_permission_action"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="28dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.ScreenTranslator.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/main_accessibility_label" />

                        <TextView
                            android:id="@+id/tvMainAccessStatus"
                            style="@style/TextAppearance.ScreenTranslator.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/common_tv_engine_status" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="28dp"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/TextAppearance.ScreenTranslator.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/main_overlay_label" />

                        <TextView
                            android:id="@+id/tvMainOverlayStatus"
                            style="@style/TextAppearance.ScreenTranslator.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/common_tv_engine_status" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
