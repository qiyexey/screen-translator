<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- M3 TopAppBar（v1.19.0）：替代原来手写的"返回"文字按钮 + 标题 TextView -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        style="@style/Widget.ScreenTranslator.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationContentDescription="@string/common_btn_back_content_description"
        app:title="@string/voice_translate_t02"
        app:menu="@menu/menu_voice_translate" />

    <!-- 引擎 / 识别：文字是运行时刷新的，放 app bar 会挤爆标题，下沉为工具栏下方的胶囊按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEngine"
            style="@style/Widget.ScreenTranslator.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/voice_translate_btn_engine"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingHorizontal="10dp" />

        <!--
          v1.24.0：识别语言下拉框**回来了**，但形态比 v1.20 克制。

          ## 为什么又加回来（一个绕了三圈才认清的事实）

          语音识别引擎**必须知道用什么语言模型解码**：

            · 不下发语言 → 引擎按系统语言硬解。中文系统下说日语会被
              转成罗马音 `konichiwa`，而不是 `こんにちは`。（v1.23.0 就是这样）
            · 下发语言   → 引擎用对应语言模型，输出正确字形。

          我们一度以为"指定语言"才是病根（v1.20 会因为选到没包的语种而
          回 12/13 关会话），但真机对照实验证明：关会话的真正原因是
          **指到了引擎根本不认的 locale**（典型 `zh-CN`，SODA 只认
          `cmn-Hans-CN`），而不是"指定了语言"本身。

          也试过 Android 14 的官方多语种检测 API，但它是**离线能力**
          （引擎日志：`Language detection can't be enabled when
          EXTRA_PREFER_OFFLINE is false`），本机一个 SODA 语言包都没装，
          开了检测反而彻底不能用。

          所以结论是：这个选择无法回避，只能把它做得尽量轻 ——
          默认跟随系统语言、**记忆上次选择**，用户切一次就不用再管。

          宽度用 0dp + weight=1：下拉框文字运行时填充，
          「中文（简体）」这类标签在窄屏上会把这一行挤换行，
          撑满剩余宽度则文字自己省略。
        -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ScreenTranslator.DropdownLayout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/spinnerLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/imeInputPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/imeInputLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/voice_translate_ime_hint"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etImeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:imeOptions="actionDone"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minLines="2"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImePicker"
                style="@style/Widget.ScreenTranslator.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/voice_translate_ime_picker" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnImeTranslate"
                style="@style/Widget.ScreenTranslator.Button.Filled"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/voice_translate_ime_translate"
                app:icon="@drawable/ic_translate"
                app:iconSize="20dp" />
        </LinearLayout>
    </LinearLayout>

    <!--
      v1.22.0：语音引擎状态提示条。

      ## 为什么不再用 AlertDialog 自动弹

      上一版在 onCreate 里发现"系统没有可用听写服务"就自动弹一个 AlertDialog。
      对话框窗口默认带 FLAG_DIM_BEHIND，**点在它外面的那一下会被系统吃掉用来
      关闭对话框、不会传给下面的 Activity**。用户看到的后果就是：

        第一次点「开始」→ 只是把弹窗关掉了，什么也没发生
        第二次点「开始」→ 才真正触发

      —— 也就是"那个按钮也有时能按有时不能"。

      结论：**凡是"还没开始操作就先弹"的提示，都不要用模态对话框**。
      改成页面上一条常驻提示条：不抢焦点、不吃点击，用户随时可以点「开始」
      （点了会有 toast + 状态行说明），要处理再点右边的「处理」。
    -->
    <LinearLayout
        android:id="@+id/hintBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="?attr/colorSecondaryContainer">

        <TextView
            android:id="@+id/tvSpeechHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeechFix"
            style="@style/Widget.ScreenTranslator.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="12sp"
            android:text="@string/voice_translate_btn_fix" />
    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        style="@style/Widget.ScreenTranslator.Divider"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <!-- 原文（实时听写） -->
    <TextView
        style="@style/TextAppearance.ScreenTranslator.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/voice_translate_t01"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvHeard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="4"
        android:layout_marginHorizontal="16dp"
        android:padding="16dp"
        android:background="@drawable/bg_translation_panel"
        android:gravity="top"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp"
        android:text="@string/voice_translate_tv_heard" />

    <!-- 译文 -->
    <TextView
        style="@style/TextAppearance.ScreenTranslator.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/common_t07"
        android:textColor="?attr/colorPrimary"
        android:textStyle="bold" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_translation_panel"
        android:fillViewport="true">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:background="@android:color/transparent"
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp"
            android:lineSpacingExtra="4dp"
            android:text="@string/common_tv_result" />
    </androidx.core.widget.NestedScrollView>

    <!-- 状态 + 控制按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/voice_translate_tv_status"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggle"
            style="@style/Widget.ScreenTranslator.Button.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="128dp"
            android:text="@string/voice_translate_btn_toggle" />
    </LinearLayout>
</LinearLayout>
